 _default = api;\n  // ===== Player Houses =====\n  const buyHouse = async (playerId, tier, latitude, longitude) => {\n    const response = await api.post('/houses/buy', {\n      player_id: playerId,\n      tier,\n      latitude,\n      longitude\n    });\n    return response.data;\n  };\n  const getPlayerHouse = async playerId => {\n    const response = await api.get(`/houses/player/${playerId}`);\n    return response.data.house;\n  };\n  const getNearbyHouses = async (latitude, longitude, radius = 2000) => {\n    const response = await api.get(`/houses/nearby?latitude=${latitude}&longitude=${longitude}&radius=${radius}`);\n    return response.data;\n  };\n  const toggleHouseHide = async (houseId, playerId) => {\n    const response = await api.post(`/houses/${houseId}/toggle-hide`, {\n      player_id: playerId\n    });\n    return response.data;\n  };\n  const sellHouse = async (houseId, playerId) => {\n    const response = await api.post(`/houses/${houseId}/sell`, {\n      player_id: playerId\n    });\n    return response.data;\n  };\n});","lineCount":1504,"map":{"__version":1,"__count":6976,"__names":["Object","defineProperty","exports","enumerable","get","_default","API_URL","getCharacterClasses","createPlayer","getPlayer","updatePlayerPosition","getNearbyPlayers","getLeaderboard","searchPlayers","getSocialStats","getFriendsList","getFriendRequests","getRelationshipStatus","followPlayer","unfollowPlayer","sendFriendRequest","acceptFriendRequest","rejectFriendRequest","removeFriend","spawnMonsters","getMonster","startBattle","battleAction","getBattle","generateMissions","completeMission","getActiveMissions","cancelMission","collectTerritoryIncome","getTerritoryIncomePreview","createGuild","getGuild","joinGuild","leaveGuild","listGuilds","getGuildChat","sendGuildMessage","deleteGuildMessage","checkGuildBattleEligibility","createGuildBattleChallenge","getGuildBattleChallenges","acceptGuildBattleChallenge","declineGuildBattleChallenge","getGuildBattle","guildBattleA